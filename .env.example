# ─────────────────────────────────────────────────────────────────────────────
# AI-HELPER-TALI — environment variables
# Copy to `.env` (or set in Vercel project settings). NEVER commit the real .env.
# Health data ("מידע בריאותי") is sensitive — treat every secret here as PHI-grade.
# ─────────────────────────────────────────────────────────────────────────────

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override; defaults to claude-opus-4-8 in code.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Postgres ---
# Pooled connection string (e.g. Vercel Postgres / Neon / Supabase pooler).
DATABASE_URL=postgres://user:password@host:5432/ai_helper_tali?sslmode=require

# --- Google Calendar (Phase 0: stubbed; fill in for Phase 1) ---
# Service account that is granted access to the central calendar + each therapist calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tali-agent@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CENTRAL_CALENDAR_ID=center@group.calendar.google.com
# Public base URL used for Google Calendar push notifications (watch channels).
GOOGLE_WEBHOOK_BASE_URL=https://your-app.vercel.app

# --- Notifications: email (Phase 1) ---
# SMTP or transactional provider (Resend/SendGrid/etc.). Channel is pluggable.
EMAIL_FROM="מרכז טיפולים <noreply@example.com>"
EMAIL_PROVIDER_API_KEY=

# --- Notifications: WhatsApp (Phase 2 — infrastructure only) ---
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Staff authentication (M2) ---
# Secret for signing staff session tokens. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
# SMS provider for OTP (chosen at M2). When unset, the OTP is logged for dev.
SMS_PROVIDER_API_KEY=
SMS_FROM=

# --- App config ---
# Comma-separated list of allowed origins for the chat API.
ALLOWED_ORIGINS=http://localhost:3000
# Default IANA timezone for the center.
CENTER_TIMEZONE=Asia/Jerusalem
# Set to "true" to allow verbose (PII-redacted) logging in development.
DEBUG_LOGGING=false
